{
  "name": "limit-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Claude Code / Codex CLI のレートリミット(5時間・週次)をブラウザで一覧表示するローカル監視アプリ",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node --watch server/index.js",
    "service:install": "node scripts/service.js install",
    "service:uninstall": "node scripts/service.js uninstall"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "node-windows": "^1.0.0-beta.8"
  }
}
